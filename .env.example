# Django
SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL) — used only if DATABASE_URL is not set
DB_NAME=editdocsnow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Alternative to the DB_* vars above: a single connection string, as
# provided automatically by Render/Heroku-style platforms.
# DATABASE_URL=postgres://user:password@host:5432/dbname
